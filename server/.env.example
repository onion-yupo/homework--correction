# 腾讯云 API 密钥
TENCENT_SECRET_ID=your_secret_id_here
TENCENT_SECRET_KEY=your_secret_key_here

# 火山引擎 Ark（豆包大模型）
ARK_API_KEY=your_ark_api_key_here

# MiniMax（作业反馈建议大模型）
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1/text/chatcompletion_v2
MINIMAX_MODEL=MiniMax-M2.7
# 可选：MiniMax 输出长度与采样参数
MINIMAX_MAX_COMPLETION_TOKENS=4096
MINIMAX_TEMPERATURE=0.7

# 火山引擎 TOS（对象存储，用于作业图片）
# 未配置密钥时系统会自动退回本地 server/data/images 存储
TOS_BUCKET=homework-123
TOS_REGION=cn-beijing
TOS_ENDPOINT=https://tos-s3-cn-beijing.volces.com
TOS_PUBLIC_BASE_URL=https://homework-123.tos-s3-cn-beijing.volces.com
TOS_ACCESS_KEY_ID=your_tos_access_key_id
TOS_SECRET_ACCESS_KEY=your_tos_secret_access_key

# 服务端口（需与 vite.config.ts 里 proxy target 一致，本地开发一般为 3300）
PORT=3300

# 公开访问地址（生成专属链接时使用）
PUBLIC_URL=https://your-domain.com/homework

# 飞书 OAuth（企业自建应用，在 https://open.feishu.cn/ 创建后填入）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT 签名密钥（生产环境用 openssl rand -base64 32 生成）
JWT_SECRET=change_this_to_a_random_32_char_secret

# 收作业/入营 token HMAC 签名密钥（独立密钥，同上方式生成）
TOKEN_SECRET=change_this_to_another_random_secret

# 本地预览可设为 true，生产必须关闭或删除
DEV_AUTH_BYPASS=false
